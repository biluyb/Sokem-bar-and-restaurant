# ==============================================================================
# SOKEM BAR AND RESTAURANT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development or .env for FServer production.
# NEVER commit real credentials or .env / .env.local files to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AUTHENTICATION & SECURITY (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# AUTH_SECRET: 32+ character random secret used by jose to sign and verify JWT session cookies.
# Generate on Linux/Mac with: openssl rand -hex 32
# REQUIRED in production. If missing, production server rejects session signing.
AUTH_SECRET="your-32-plus-character-random-hex-secret-here"

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# DATABASE_URL: Prisma database connection string.
# - SQLite (Zero external services, recommended for standalone simple VPS / FServer):
#   DATABASE_URL="file:./dev.db"
# - PostgreSQL (For managed Supabase, Neon, or local Postgres on FServer):
#   DATABASE_URL="postgresql://dbuser:dbpassword@127.0.0.1:5432/sokem_restaurant?schema=public"
# REQUIRED in production.
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 3. INITIAL SUPER ADMIN & EMERGENCY FALLBACK CREDENTIALS (RECOMMENDED)
# ------------------------------------------------------------------------------
# ADMIN_EMAIL: Primary system admin email address.
ADMIN_EMAIL="admin@sokem-restaurant.com"

# ADMIN_PASSWORD_HASH: Bcrypt hash of the admin password.
# Used for emergency access / initial bootstrap fallback if database is offline.
# Generate with: npx bcrypt-cli hash "YourSecurePassword" 10
# (Remember to escape '$' as '\$' in .env files to prevent variable expansion)
ADMIN_PASSWORD_HASH=""

# ADMIN_NAME: Display name of the initial super admin.
ADMIN_NAME="Sokem Operations Director"

# Initial passwords for database seeder (`npx prisma db seed`)
ADMIN_INITIAL_PASSWORD=""
STAFF_INITIAL_PASSWORD=""

# ------------------------------------------------------------------------------
# 4. EMAIL & CONTACT NOTIFICATION (REQUIRED FOR LIVE CONTACT & RESERVATION ALERTS)
# ------------------------------------------------------------------------------
# Direct message and reservation alerts are dispatched via server-side SMTP.
# SMTP_HOST: SMTP host server (e.g. smtp.gmail.com, mail.yourdomain.com)
SMTP_HOST="smtp.gmail.com"

# SMTP_PORT: SMTP port (465 for SSL, 587 for TLS)
SMTP_PORT=465

# SMTP_USER: Username or email for the sending SMTP account
SMTP_USER="notifications@yourdomain.com"

# SMTP_PASS: SMTP password or Google App Password (16 characters)
SMTP_PASS="your-smtp-app-password"

# CONTACT_EMAIL: Recipient email address for customer inquiries and booking notifications
CONTACT_EMAIL="manager@yourdomain.com"

# ------------------------------------------------------------------------------
# 5. PUBLIC SITE URL & SEO (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Canonical URL of the website used for OpenGraph, sitemap, and redirects.
# Expose to browser via NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SITE_URL="https://sokembar.com"
