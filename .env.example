# Authentication Secrets
AUTH_SECRET="your-secure-random-auth-secret-min-32-chars"

# Database (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/sokem_restaurant?schema=public"

# Public site settings
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SMTP Email Settings (for Contact Form)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
CONTACT_EMAIL="reservations@sokem-restaurant.com"
