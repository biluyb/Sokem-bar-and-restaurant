# ==============================================================================
# SOKEM BAR AND RESTAURANT — .gitignore
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js Build Output & Cache
/.next/
/out/
/build

# Environment files & Secrets
# NEVER commit environment files containing secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production
.env.production.local
.env*.local
# Explicitly keep .env.example tracked
!.env.example

# Certificates, Keys & Credentials
*.pem
*.key
*.crt
*.pfx
*.p12
*.cer
id_rsa*

# Local Databases & Journals
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/dev.db
prisma/dev.db-journal

# User Uploaded Content
/public/uploads/*
!/public/uploads/.gitkeep

# Logs & Debug Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Files
.DS_Store
Thumbs.db

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts

# Vercel deployment cache
.vercel
